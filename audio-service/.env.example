# Copy to ../secret/audio.env (the repo ignores "secret/") and fill in. Never commit a real key.
# PROVIDER: gradium | fake | off
PROVIDER=gradium
GRADIUM_API_KEY=
GRADIUM_MODEL=gradium-tts-beta
GRADIUM_FALLBACK_MODEL=default
# STORAGE: local (dev, files served under /cdn) | s3 (bucket dixvoice-clips behind CloudFront)
STORAGE=local
CDN_PUBLIC_URL=http://localhost:8080/cdn
SERVE_LOCAL_CDN=1
# For STORAGE=s3: AWS keys go in ../secret/aws.env
# S3_BUCKET=dixvoice-clips
# AWS_REGION=eu-west-1
# CDN_PUBLIC_URL=https://dp1tbjxi4bfec.cloudfront.net
